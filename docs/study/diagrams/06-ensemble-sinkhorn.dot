digraph sinkhorn_zoom {
  rankdir=TB; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  P   [label="P: blended probs\nN x 76, rows sum to 1"];
  pi  [label="pi: target class shares (76,)\ntrain counts + 0.5, normalised\n(NONE about 1/3; frequent codes\ncapped at 57 of 1,500 rows,\nmedian code 8 rows)"];
  b0  [label="b = zeros(76)"];
  Q   [label="Q = normalize(P * exp(b))\nrow-normalise: each row sums to 1"];
  m   [label="col = Q.mean(axis=0)  (76,)\n'how often the model\nthinks each class occurs'"];
  up  [label="b += log(pi / col)\nraise under-predicted classes,\nlower over-predicted ones"];
  conv [label="after 30-50 rounds:\ncolumn means of Q ~= pi\n(rows still sum to 1)"];
  lam [label="Q_lambda = normalize(P * exp(lambda * b))\nlambda=0 -> P unchanged\nlambda=1 -> full matching\nlambda=0.5 chosen"];
  out [label="top-3 per row\n(test: top-1 changed on 3.7% of rows,\ntop-3 set changed on 26.4%)"];
  P -> Q; b0 -> Q; Q -> m; pi -> up; m -> up; up -> Q [label="repeat", style=dashed]; up -> conv -> lam; P -> lam; lam -> out;
}
